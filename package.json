{
  "name": "cca-training",
  "version": "1.0.1",
  "description": "Node.js + Express app with Claude API integration",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "scripts": {
    "start": "node --env-file=.env --experimental-strip-types src/index.ts",
    "dev": "node --env-file=.env --watch --experimental-strip-types src/index.ts",
    "release": "release-it "
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@types/node": "^25.6.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "linebyline": "^1.3.0",
    "readline": "^1.3.0",
    "readline-promise": "^1.0.5"
  },
  "devDependencies": {
    "release-it": "^20.0.0"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    }
  }
}
